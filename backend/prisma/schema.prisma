generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  firebaseUid     String    @unique
  username        String
  email           String    @unique
  avatar          String?
  discordId       String?
  role            String    @default("user") // user, admin, superadmin
  coins           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders          Order[]
  servers         Server[]
  invoices        Invoice[]
  payments        Payment[]
  coinTransactions CoinTransaction[]
  referrals       Referral[] @relation("referredBy")
  referredUsers   User[]     @relation("referredBy")
  referrerId      String?
  lastDailyReward DateTime?
  lastLoginReward DateTime?

  @@index([firebaseUid])
  @@index([email])
}

model Product {
  id              String    @id @default(uuid())
  name            String
  description     String?
  category        String    // minecraft, vps, game, bot, web
  price           Decimal
  coinPrice       Int
  billingCycle    String    // monthly, quarterly, yearly, lifetime
  ram             Int       // in MB
  cpu             Int       // in percentage
  disk            Int       // in MB
  databases       Int
  backups         Int
  node            String?
  egg             String?
  allocation      String?
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orderItems      OrderItem[]

  @@index([category])
  @@index([enabled])
}

model Order {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  totalAmount     Decimal
  coinAmount      Int       @default(0)
  status          String    @default("pending") // pending, completed, cancelled, refunded
  paymentMethod   String?   // stripe, paypal, crypto, coins
  paymentId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items           OrderItem[]
  servers         Server[]
  invoices        Invoice[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id              String    @id @default(uuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  quantity        Int       @default(1)
  price           Decimal
  coinPrice       Int

  @@index([orderId])
  @@index([productId])
}

model Server {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  orderId         String?
  order           Order?    @relation(fields: [orderId], references: [id])
  pteroId         String?   // Pterodactyl server ID
  pteroPanelId    String?   // Which panel this server is on
  name            String
  status          String    @default("installing") // installing, running, suspended, expired, deleted
  ram             Int
  cpu             Int
  disk            Int
  databases       Int
  backups         Int
  egg             String
  node            String
  expiresAt       DateTime?
  suspendedAt     DateTime?
  deletedAt       DateTime?
  lastBackupAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([pteroId])
  @@index([status])
  @@index([expiresAt])
}

model Invoice {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  orderId         String?
  order           Order?    @relation(fields: [orderId], references: [id])
  amount          Decimal
  status          String    @default("unpaid") // unpaid, paid, overdue, cancelled
  dueDate         DateTime
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  amount          Decimal
  method          String    // stripe, paypal, crypto
  status          String    @default("pending") // pending, completed, failed, refunded
  transactionId   String?
  gatewayData     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([transactionId])
  @@index([status])
}

model CoinTransaction {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  amount          Int       // positive for add, negative for deduct
  balance         Int       // balance after transaction
  type            String    // signup, purchase, renewal, admin, reward, referral, daily
  description     String
  referenceId     String?   // order ID or other reference
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Media {
  id              String    @id @default(uuid())
  filename        String
  originalName    String
  url             String
  type            String    // image, gif, video, icon, logo
  mimeType        String
  size            Int
  uploadedBy      String
  createdAt       DateTime  @default(now())

  @@index([type])
}

model Settings {
  id              String    @id @default(uuid())
  key             String    @unique
  value           Json
  category        String?   // branding, theme, coins, general
  updatedAt       DateTime  @updatedAt

  @@index([category])
}

model PterodactylPanel {
  id              String    @id @default(uuid())
  name            String
  url             String
  appApiKey       String
  clientApiKey    String?
  nodeId          String?
  eggId           String?
  locationId      String?
  enabled         Boolean   @default(true)
  lastChecked     DateTime?
  status          String?   // online, offline, error
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  servers         Server[]

  @@index([enabled])
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  type            String    // percentage, fixed, coins
  value           Decimal
  maxUses         Int?
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  minPurchase     Decimal?
  applicableProducts String? // comma-separated product IDs or "all"
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([code])
  @@index([active])
}

model Referral {
  id              String    @id @default(uuid())
  referrerId      String
  referrer        User      @relation("referredBy", fields: [referrerId], references: [id])
  referredId      String    @unique
  referred        User      @relation(fields: [referredId], references: [id])
  rewarded        Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([referrerId])
  @@index([referredId])
}

model Log {
  id              String    @id @default(uuid())
  action          String
  userId          String?
  details         Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  @@index([action])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id              String    @id @default(uuid())
  userId          String
  title           String
  message         String
  type            String    // order, server, payment, system
  read            Boolean   @default(false)
  actionUrl       String?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([read])
  @@index([type])
}