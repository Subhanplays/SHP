# Database (SQLite - no external service needed)
# Default is ./data/shp.db inside the backend folder
# DATABASE_PATH="./data/shp.db"

# JWT Secret (change this!)
JWT_SECRET="your-super-secret-jwt-key-change-this"

# Server
PORT=5000
NODE_ENV=development

# CORS
FRONTEND_URL="http://localhost:5173"

# Backend base URL (used to build OAuth callback URLs)
BACKEND_URL="http://localhost:5000"

# Google OAuth Login
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Discord OAuth Login
DISCORD_CLIENT_ID="your-discord-app-id"
DISCORD_CLIENT_SECRET="your-discord-app-secret"

# Initial admin account (used by `npm run seed`)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@shp.com"
ADMIN_PASSWORD="admin123"

# Email (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@subhanhostpanel.com"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# PayPal
PAYPAL_CLIENT_ID="..."
PAYPAL_CLIENT_SECRET="..."
PAYPAL_MODE="sandbox"

# Discord Webhook (for notifications)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Crypto Payments (Coinbase Commerce)
COINBASE_API_KEY="..."

# Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"
